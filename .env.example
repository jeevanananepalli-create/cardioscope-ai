# Copy to .env and adjust. No secrets are required to run CardioScope AI.

# --- API ---------------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated).
CARDIOSCOPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Upper bounds of the low / moderate / high visualization bands (three increasing
# values between 0 and 1). These are display categories, not clinical thresholds.
CARDIOSCOPE_RISK_THRESHOLDS=0.25,0.50,0.75
CARDIOSCOPE_LOG_LEVEL=INFO
# Where trained model artifacts are read from (default: ml/models).
# CARDIOSCOPE_MODELS_DIR=ml/models

# --- ML ----------------------------------------------------------------------
# Dataset location (default: ml/data/raw/extention of Z-Alizadeh sani dataset.xlsx).
# CARDIOSCOPE_DATASET_PATH=

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
